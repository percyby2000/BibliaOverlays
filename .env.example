# ==============================================================================
# BIBLE OVERLAY STUDIO - ENVIRONMENT VARIABLES
# ==============================================================================
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
#
# NOTA: La aplicación cuenta con MODO DEMO OFFLINE AUTOMÁTICO.
# Si estas variables están vacías, la aplicación funcionará de forma autónoma
# con sincronización local (BroadcastChannel / LocalStorage) y base de datos
# bíblica enriquecida de demostración (RVR1960, NVI, DHH, etc.).
# ==============================================================================

# Supabase (PostgreSQL, Auth y Realtime)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta-aqui

# YouVersion API (Solo lado servidor - nunca expuesta al cliente)
YOUVERSION_API_KEY=tu-youversion-api-key-aqui
YOUVERSION_API_BASE_URL=https://api.youversion.com/v1

# Configuración de la Aplicación
PUBLIC_APP_URL=http://localhost:4321
DEFAULT_OVERLAY_ID=main-lower-third
