---
import { OverlayStudioApp } from '../components/studio/OverlayStudioApp';
import '../styles/global.css';

export const prerender = false;
---

<!doctype html>
<html lang="es" class="h-full w-full dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Bible Overlay Studio - Panel de Control de Emisión en Vivo para OBS Studio" />
    <title>Panel de Control | Biblia Overlay</title>
    <link rel="icon" type="image/svg+xml" href="/1.svg" />
  </head>
  <body class="studio-body h-full w-full bg-background text-foreground overflow-hidden">
    <OverlayStudioApp client:only="react" />
  </body>
</html>
