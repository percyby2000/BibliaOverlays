---
import OverlayLayout from '../../layouts/OverlayLayout.astro';
import { OverlayRenderer } from '../../components/overlay/OverlayRenderer';

export const prerender = false;

const { id = 'transmision' } = Astro.params;
---

<OverlayLayout title={`Bible Overlay - ${id}`} overlayId={id}>
  <main class="w-screen h-screen overflow-hidden bg-transparent select-none">
    <OverlayRenderer client:only="react" overlayId={id} />
  </main>
</OverlayLayout>
